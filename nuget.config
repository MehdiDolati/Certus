<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Vendored local feed carrying the validator web-integration packages built by
         financial-data-cleaner (scripts/pack-validator-packages.ps1). Committed to the
         repo so CI (Linux) can restore them without a Windows-only absolute path. -->
    <add key="validator-local" value="vendor/validator-packages" />
  </packageSources>
</configuration>