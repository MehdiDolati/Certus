@if (Data?.Any() == true)
{
    <MudPaper Class="pa-4" Style="background: #1e293b; border-radius: 12px;">
        <MudText Typo="Typo.h6" Class="mb-4" Style="color: white;">Equity Curve</MudText>
        <div style="position: relative; height: 300px; border: 1px solid #334155; border-radius: 8px; overflow: hidden;">
            <svg width="100%" height="100%" viewBox="0 0 800 300" preserveAspectRatio="none">
                @* Grid lines *@
                @for (int i = 0; i < 5; i++)
                {
                    var y = 30 + i * 60;
                    <line x1="0" y1="@y" x2="800" y2="@y" stroke="#334155" stroke-width="1" />
                }
                @* Actual line *@
                <polyline points="@GetActualPoints()" fill="none" stroke="#22c55e" stroke-width="2" />
                @* Supposed line *@
                <polyline points="@GetSupposedPoints()" fill="none" stroke="#94a3b8" stroke-width="2" stroke-dasharray="5,5" />
            </svg>
            <div style="position: absolute; top: 8px; right: 12px; display: flex; gap: 16px;">
                <span style="color: #22c55e; font-size: 12px;">&#9644; Actual</span>
                <span style="color: #94a3b8; font-size: 12px;">&#9644; Target</span>
            </div>
        </div>
    </MudPaper>
}

@code {
    [Parameter] public List<PerformanceSnapshotDto>? Data { get; set; }

    private string GetActualPoints()
    {
        if (Data == null || !Data.Any()) return "";
        var min = Data.Min(d => d.Equity);
        var max = Data.Max(d => d.Equity);
        var range = max - min;
        if (range == 0) range = 1;
        return string.Join(" ", Data.Select((d, i) =>
        {
            var x = (double)i / (Data.Count - 1) * 800;
            var y = 280 - ((double)(d.Equity - min) / (double)range * 260);
            return $"{x:F1},{y:F1}";
        }));
    }

    private string GetSupposedPoints()
    {
        if (Data == null || !Data.Any()) return "";
        var first = Data.First();
        var min = Data.Min(d => d.Equity / (1 + d.ActualReturn / 100m) * (1 + d.SupposedReturn / 100m));
        var max = Data.Max(d => d.Equity / (1 + d.ActualReturn / 100m) * (1 + d.SupposedReturn / 100m));
        var range = max - min;
        if (range == 0) range = 1;
        return string.Join(" ", Data.Select((d, i) =>
        {
            var val = d.Equity / (1 + d.ActualReturn / 100m) * (1 + d.SupposedReturn / 100m);
            var x = (double)i / (Data.Count - 1) * 800;
            var y = 280 - ((double)(val - min) / (double)range * 260);
            return $"{x:F1},{y:F1}";
        }));
    }
}
