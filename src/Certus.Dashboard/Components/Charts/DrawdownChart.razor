@if (Data?.Any() == true)
{
    <MudPaper Class="pa-4" Style="background: #1e293b; border-radius: 12px;">
        <MudText Typo="Typo.h6" Class="mb-4" Style="color: white;">Drawdown</MudText>
        <div style="position: relative; height: 200px; border: 1px solid #334155; border-radius: 8px; overflow: hidden;">
            <svg width="100%" height="100%" viewBox="0 0 800 200" preserveAspectRatio="none">
                @for (int i = 0; i < 4; i++)
                {
                    var y = 25 + i * 50;
                    <line x1="0" y1="@y" x2="800" y2="@y" stroke="#334155" stroke-width="1" />
                }
                <polyline points="@GetDrawdownPoints()" fill="rgba(239,68,68,0.3)" stroke="#ef4444" stroke-width="1.5" />
            </svg>
        </div>
    </MudPaper>
}

@code {
    [Parameter] public List<PerformanceSnapshotDto>? Data { get; set; }

    private string GetDrawdownPoints()
    {
        if (Data == null || !Data.Any()) return "";
        var minDd = Data.Min(d => d.Drawdown);
        var range = Math.Abs((double)minDd);
        if (range == 0) range = 1;
        var points = Data.Select((d, i) =>
        {
            var x = (double)i / (Data.Count - 1) * 800;
            var y = Math.Abs((double)d.Drawdown) / range * 180;
            return $"{x:F1},{y:F1}";
        });
        return "0,0 " + string.Join(" ", points) + " 800,0";
    }
}
