@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Style="background: #0f172a; border-bottom: 1px solid #1e293b;" Elevation="0">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Style="color: white; font-weight: 700; letter-spacing: 0.05em;">
            CERTUS
        </MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Style="color: #64748b;">Autonomous Trading Platform</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen" Variant="DrawerVariant.Mini"
               Style="background: #0f172a; border-right: 1px solid #1e293b;">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Style="background: #0f172a; min-height: 100vh;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        Typography = new Typography()
        {
            Default = new Default()
            {
                FontFamily = new[] { "Roboto", "sans-serif" }
            }
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
