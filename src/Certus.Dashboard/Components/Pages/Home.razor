@page "/"
@rendermode InteractiveServer

<PageTitle>Certus Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <MudText Typo="Typo.h3" Style="color: white; font-weight: 700;" Class="mb-4">Certus Dashboard</MudText>
    <MudText Typo="Typo.body1" Style="color: #94a3b8;" Class="mb-6">
        Autonomous multi-agent trading platform.
    </MudText>
    <MudButton Href="/portfolios" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
               StartIcon="@Icons.Material.Filled.AccountBalance">
        View Portfolios
    </MudButton>
</MudContainer>
