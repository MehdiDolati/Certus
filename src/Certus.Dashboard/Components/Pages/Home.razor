@page "/"
@rendermode InteractiveServer
@using Certus.Application.Platform.DTOs
@inject IPortfolioService PortfolioService
@inject IPlatformService PlatformService
@inject ITradeService TradeService
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Certus Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-6">
    <div style="margin-bottom: 32px;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: linear-gradient(135deg, #3b82f6, #8b5cf6); display: flex; align-items: center; justify-content: center;">
                <MudIcon Icon="@Icons.Material.Filled.SpaceDashboard" Size="Size.Medium" Style="color: white;" />
            </div>
            <div>
                <MudText Typo="Typo.h4" Style="color: white; font-weight: 800; letter-spacing: -0.02em;">Command Center</MudText>
                <MudText Typo="Typo.body2" Style="color: #64748b;">Monitor and control your trading platform</MudText>
            </div>
        </div>
    </div>

    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Total Portfolios" Value="@_kpis.PortfolioCount.ToString()"
                     Icon="@Icons.Material.Filled.AccountBalance" IconColor="#3b82f6" IconBgColor="rgba(59, 130, 246, 0.15)"
                     IsLoading="@_loading" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Active Portfolios" Value="@_kpis.ActivePortfolioCount.ToString()"
                     Icon="@Icons.Material.Filled.PlayArrow" IconColor="#00ff88" IconBgColor="rgba(0, 255, 136, 0.12)"
                     IsLoading="@_loading" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Total AUM" Value="@FormatCurrency(_kpis.TotalAum)"
                     Icon="@Icons.Material.Filled.AccountBalance" IconColor="#a855f7" IconBgColor="rgba(168, 85, 247, 0.15)"
                     IsLoading="@_loading" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Total PnL" Value="@FormatCurrency(_kpis.TotalPnl)"
                     Trend="@(FormatTrend(_kpis.TotalPnl))"
                     Icon="@Icons.Material.Filled.TrendingUp" IconColor="@(_kpis.TotalPnl >= 0 ? "#00ff88" : "#ff4466")" IconBgColor="@(_kpis.TotalPnl >= 0 ? "rgba(0, 255, 136, 0.12)" : "rgba(255, 68, 102, 0.12)")"
                     IsLoading="@_loading" />
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Executed Trades" Value="@_kpis.ExecutedTradeCount.ToString()"
                     Icon="@Icons.Material.Filled.SwapHoriz" IconColor="#f59e0b" IconBgColor="rgba(245, 158, 11, 0.12)"
                     IsLoading="@_loading" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Imported Trades" Value="@_kpis.ImportedTradeCount.ToString()"
                     Icon="@Icons.Material.Filled.FileDownload" IconColor="#06b6d4" IconBgColor="rgba(6, 182, 212, 0.12)"
                     IsLoading="@_loading" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Connections" Value="@($"{_platformDashboard.ActiveConnections}/{_platformDashboard.TotalConnections}")"
                     Icon="@Icons.Material.Filled.Hub" IconColor="#ec4899" IconBgColor="rgba(236, 72, 153, 0.12)"
                     IsLoading="@_loading" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Avg Sharpe" Value="@_kpis.AvgSharpe.ToString("N2")"
                     Icon="@Icons.Material.Filled.Speed" IconColor="#8b5cf6" IconBgColor="rgba(139, 92, 246, 0.12)"
                     IsLoading="@_loading" />
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-5 mb-4" Style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border: 1px solid #334155; border-radius: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(236, 72, 153, 0.15); display: flex; align-items: center; justify-content: center;">
                            <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Small" Style="color: #ec4899;" />
                        </div>
                        <MudText Typo="Typo.h6" Style="color: white; font-weight: 700;">Platform Connections</MudText>
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/platform"
                               StartIcon="@Icons.Material.Filled.ArrowForward" Size="Size.Small"
                               Style="border-color: #334155; text-transform: none; font-weight: 500;">View All</MudButton>
                </div>
                @if (_loading)
                {
                    @for (int i = 0; i < 2; i++)
                    {
                        <MudSkeleton Animation="Animation.Wave" Height="64px" Class="mb-2" Style="border-radius: 12px;" />
                    }
                }
                else if (!_platformDashboard.Connections.Any())
                {
                    <div style="text-align: center; padding: 32px 0;">
                        <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Large" Style="color: #334155;" />
                        <MudText Typo="Typo.body2" Style="color: #475569; margin-top: 12px;">No platform connections configured.</MudText>
                    </div>
                }
                else
                {
                    @foreach (var conn in _platformDashboard.Connections)
                    {
                        <div style="display: flex; align-items: center; gap: 14px; padding: 14px 16px; background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 12px; margin-bottom: 10px;">
                            <div style="width: 40px; height: 40px; border-radius: 10px; background: @(GetConnectionBg(conn.Status)); display: flex; align-items: center; justify-content: center;">
                                <MudIcon Icon="@GetConnectionIcon(conn.Status)" Size="Size.Small"
                                         Style="@($"color: {GetConnectionColor(conn.Status)};")" />
                            </div>
                            <div style="flex: 1;">
                                <MudText Typo="Typo.body2" Style="color: white; font-weight: 600;">@conn.PlatformName</MudText>
                                <div style="display: flex; align-items: center; gap: 6px; margin-top: 2px;">
                                    <div style="width: 6px; height: 6px; border-radius: 50%; background: @(GetConnectionColor(conn.Status));"></div>
                                    <MudText Typo="Typo.caption" Style="color: #64748b;">@conn.Status</MudText>
                                </div>
                            </div>
                            @if (conn.LastDataReceivedAt.HasValue)
                            {
                                <MudText Typo="Typo.caption" Style="color: #475569;">
                                    @conn.LastDataReceivedAt.Value.ToString("MMM dd, HH:mm")
                                </MudText>
                            }
                        </div>
                    }
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="pa-5 mb-4" Style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border: 1px solid #334155; border-radius: 16px;">
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
                    <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(59, 130, 246, 0.15); display: flex; align-items: center; justify-content: center;">
                        <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" Style="color: #3b82f6;" />
                    </div>
                    <MudText Typo="Typo.h6" Style="color: white; font-weight: 700;">Quick Actions</MudText>
                </div>
                <MudButton Variant="Variant.Filled" Href="/portfolios"
                           FullWidth="true" Class="mb-3"
                           Style="background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; text-transform: none; font-weight: 600; border-radius: 10px; padding: 10px 16px;"
                           StartIcon="@Icons.Material.Filled.AccountBalance">
                    View Portfolios
                </MudButton>
                <MudButton Variant="Variant.Outlined" Href="/platform"
                           FullWidth="true"
                           Style="border-color: #334155; color: #94a3b8; text-transform: none; font-weight: 500; border-radius: 10px; padding: 10px 16px;"
                           StartIcon="@Icons.Material.Filled.Hub">
                    Platform Management
                </MudButton>
            </MudPaper>

            <MudPaper Class="pa-5" Style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border: 1px solid #334155; border-radius: 16px;">
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
                    <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(0, 255, 136, 0.12); display: flex; align-items: center; justify-content: center;">
                        <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Size="Size.Small" Style="color: #00ff88;" />
                    </div>
                    <MudText Typo="Typo.h6" Style="color: white; font-weight: 700;">System Health</MudText>
                </div>
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <MudText Typo="Typo.body2" Style="color: #94a3b8;">Platform Status</MudText>
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <div style="width: 8px; height: 8px; border-radius: 50%; background: @(GetStatusColor()); box-shadow: 0 0 8px @(GetStatusColor());"></div>
                            <MudText Typo="Typo.body2" Style="@($"color: {GetStatusColor()}; font-weight: 600;")">
                                @(_platformDashboard.ActiveConnections > 0 ? "Online" : "Offline")
                            </MudText>
                        </div>
                    </div>
                    <div style="height: 1px; background: #1e293b;"></div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <MudText Typo="Typo.body2" Style="color: #94a3b8;">Total PnL</MudText>
                        <MudText Typo="Typo.body2" Style="@($"color: {GetPnlColor()}; font-weight: 600;")">
                            @FormatCurrency(_platformDashboard.TotalPnL)
                        </MudText>
                    </div>
                    <div style="height: 1px; background: #1e293b;"></div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <MudText Typo="Typo.body2" Style="color: #94a3b8;">Imported Trades</MudText>
                        <MudText Typo="Typo.body2" Style="color: white; font-weight: 600;">@_platformDashboard.TotalTrades</MudText>
                    </div>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private bool _loading = true;
    private bool _disposed;
    private DashboardOverview _kpis = new();
    private PlatformDashboardDto _platformDashboard = new();
    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            if (_disposed) return;
            try
            {
                await InvokeAsync(async () =>
                {
                    if (_disposed) return;
                    await LoadData();
                });
            }
            catch (ObjectDisposedException) { }
        }, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    public void Dispose()
    {
        _disposed = true;
        _refreshTimer?.Dispose();
    }

    private async Task LoadData()
    {
        _loading = _kpis.PortfolioCount == 0;
        StateHasChanged();

        var period = Certus.Domain.SharedKernel.DateRange.All;

        var portfolios = await PortfolioService.GetAllPortfoliosAsync(new PortfolioFilter(Period: period));
        _platformDashboard = await PlatformService.GetDashboardAsync();

        var totalAum = portfolios.Sum(p => p.Aum);
        var totalPnl = portfolios.Sum(p => p.ActualReturn * p.Aum);
        var avgSharpe = portfolios.Count > 0 ? portfolios.Average(p => p.Sharpe) : 0m;
        var winRate = portfolios.Count > 0 ? portfolios.Average(p => p.WinRate) : 0m;
        var executedTradeCount = portfolios.Sum(p => p.TradeCount);
        var activeCount = portfolios.Count(p => p.Status == PortfolioStatus.Active);

        _kpis = new DashboardOverview
        {
            PortfolioCount = portfolios.Count,
            ActivePortfolioCount = activeCount,
            TotalAum = totalAum,
            TotalPnl = totalPnl,
            ExecutedTradeCount = executedTradeCount,
            ImportedTradeCount = _platformDashboard.TotalTrades,
            AvgSharpe = avgSharpe
        };

        _loading = false;
        StateHasChanged();
    }

    private string FormatCurrency(decimal value) => value switch
    {
        >= 1_000_000 => $"${value / 1_000_000:N1}M",
        >= 1_000 => $"${value / 1_000:N1}K",
        _ => FormatCurrencyDefault(value)
    };

    private static string FormatCurrencyDefault(decimal value) =>
        Math.Abs(value) != value ? $"-${Math.Abs(value):N0}" : $"${value:N0}";

    private decimal FormatTrend(decimal value) => value >= 0 ? 1m : -1m;

    private string GetConnectionIcon(PlatformConnectionStatus status) => status switch
    {
        PlatformConnectionStatus.Connected => Icons.Material.Filled.CheckCircle,
        PlatformConnectionStatus.Connecting => Icons.Material.Filled.Sync,
        PlatformConnectionStatus.Reconnecting => Icons.Material.Filled.SyncProblem,
        PlatformConnectionStatus.Error => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.HighlightOff
    };

    private string GetConnectionColor(PlatformConnectionStatus status) => status switch
    {
        PlatformConnectionStatus.Connected => "#00ff88",
        PlatformConnectionStatus.Connecting => "#f59e0b",
        PlatformConnectionStatus.Reconnecting => "#f59e0b",
        PlatformConnectionStatus.Error => "#ff4466",
        _ => "#475569"
    };

    private string GetConnectionBg(PlatformConnectionStatus status) => status switch
    {
        PlatformConnectionStatus.Connected => "rgba(0, 255, 136, 0.12)",
        PlatformConnectionStatus.Connecting => "rgba(245, 158, 11, 0.12)",
        PlatformConnectionStatus.Reconnecting => "rgba(245, 158, 11, 0.12)",
        PlatformConnectionStatus.Error => "rgba(255, 68, 102, 0.12)",
        _ => "rgba(71, 85, 105, 0.12)"
    };

    private string GetStatusColor()
    {
        var status = _platformDashboard.ActiveConnections > 0
            ? PlatformConnectionStatus.Connected
            : PlatformConnectionStatus.Disconnected;
        return GetConnectionColor(status);
    }

    private string GetPnlColor() => _platformDashboard.TotalPnL >= 0 ? "#00ff88" : "#ff4466";

    private class DashboardOverview
    {
        public int PortfolioCount { get; set; }
        public int ActivePortfolioCount { get; set; }
        public decimal TotalAum { get; set; }
        public decimal TotalPnl { get; set; }
        public int ExecutedTradeCount { get; set; }
        public int ImportedTradeCount { get; set; }
        public decimal AvgSharpe { get; set; }
    }
}
