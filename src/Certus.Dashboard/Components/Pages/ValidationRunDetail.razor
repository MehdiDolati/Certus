@page "/validation/runs/{RunId}"
@using Validator.Application.Abstractions
@using Validator.Application.Web
@inject IValidationWebService ValidationService

<PageTitle>Validation Run @RunId</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-6">
    <PageHeader Title="Validation Run"
                Description="Durable run result. This page reflects the stored run state and never triggers new work."
                Icon="@Icons.Material.Filled.FactCheck" />

    @if (IsLoading)
    {
        @* S1 / AC-014: skeleton treatment on first render — no blank white region. *@
        <DashboardCard>
            <MudSkeleton Animation="Animation.Wave" Height="40px" Width="280px" Class="mb-4" />
            @for (int i = 0; i < 4; i++)
            {
                <MudSkeleton Animation="Animation.Wave" Height="28px" Class="mb-2" />
            }
        </DashboardCard>
    }
    else if (UnavailableReason is not null)
    {
        @* S7: unavailable/unknown/expired/invalid id — no crash. *@
        <EmptyState Icon="@Icons.Material.Filled.SearchOff"
                    Title="Run unavailable"
                    Description="@UnavailableReason" />
    }
    else if (Status is WebRunStatus.Pending or WebRunStatus.Running)
    {
        @* S2/S3, AC-010: informational banner + progress + refresh action. *@
        <MudAlert Severity="Severity.Info" Class="mb-4">
            <div style="display: flex; align-items: center; gap: 8px;">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <span>The run is @Status.ToString().ToLowerInvariant(). This page reflects the durable run state and never triggers work.</span>
            </div>
        </MudAlert>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync">Refresh status</MudButton>
    }
    else if (View is not null && View.Status == WebRunStatus.Failed)
    {
        @* S6, AC-009: failure banner — message + diagnostic code + guidance. *@
        <MudAlert Severity="Severity.Error" Class="mb-4">
            <MudText Typo="Typo.h6">Validation failed</MudText>
            <MudText Typo="Typo.body2"><strong>@View.Diagnostic?.Code</strong> &mdash; @View.Diagnostic?.Reason</MudText>
            <MudText Typo="Typo.caption">@View.Diagnostic?.Guidance</MudText>
        </MudAlert>
    }
    else if (View is not null)
    {
        var summary = View.Validation?.Summary;
        var severity = View.Status == WebRunStatus.CompletedClean ? Severity.Success : Severity.Warning;
        @* S4/S5, AC-007/AC-008: success/warning banner per state→severity map. *@
        <MudAlert Severity="@severity" Class="mb-4">
            @(View.Status == WebRunStatus.CompletedClean
                ? "Validation complete: the dataset is clean."
                : "Validation complete: findings detected.")
        </MudAlert>

        @if (summary is not null)
        {
            @* S4/S5, AC-011: quality counts in a dashboard-styled table inside a card. *@
            <DashboardCard Class="mb-4">
                <MudText Typo="Typo.h6" Class="mb-2" Style="color: white; font-weight: 700;">Quality checks</MudText>
                <MudSimpleTable Hover="true" Dense="true" Class="mt-2" Style="background: #1e293b;">
                    <thead>
                        <tr><th style="color: #94a3b8;">Check</th><th style="color: #94a3b8;">Count</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Missing candles</td><td>@summary.MissingCandles</td></tr>
                        <tr><td>Duplicate records</td><td>@summary.DuplicateRecords</td></tr>
                        <tr><td>Invalid OHLC</td><td>@summary.InvalidOhlc</td></tr>
                        <tr><td>Closed-market records</td><td>@summary.ClosedMarketRecords</td></tr>
                        <tr><td>Time gaps</td><td>@summary.TimeGaps</td></tr>
                        <tr><td>Malformed rows</td><td>@summary.MalformedRows</td></tr>
                    </tbody>
                </MudSimpleTable>
            </DashboardCard>
        }

        @if (View.Scoring is not null)
        {
            @* S8, AC-013: scoring in a dashboard-styled table on the standard scale. *@
            <DashboardCard Class="mb-4">
                <MudText Typo="Typo.h6" Class="mb-2" Style="color: white; font-weight: 700;">Quality score</MudText>
                <MudText Typo="Typo.h5" Style="color: white; font-weight: 800; font-family: 'Inter', monospace; letter-spacing: -0.02em;">
                    Dataset average: @(View.Scoring.Score.Dataset.Average?.Format() ?? "unavailable") / @View.Scoring.Score.Scale.Maximum
                </MudText>
                <MudSimpleTable Hover="true" Dense="true" Class="mt-2" Style="background: #1e293b;">
                    <thead>
                        <tr><th style="color: #94a3b8;">Dimension</th><th style="color: #94a3b8;">State</th><th style="color: #94a3b8;">Score</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var metric in View.Scoring.Score.Metrics)
                        {
                            <tr>
                                <td>@metric.Category</td>
                                <td>@metric.State</td>
                                <td>@(metric.Score?.Format() ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </DashboardCard>
        }

        @if (View.AvailableExports.Count > 0)
        {
            @* S9, AC-012: one secondary (outlined) button per available export. *@
            <DashboardCard Class="mb-4">
                <MudText Typo="Typo.h6" Class="mb-2" Style="color: white; font-weight: 700;">Download report</MudText>
                @foreach (var representation in View.AvailableExports)
                {
                    <MudButton Class="mr-2 mb-2" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="() => DownloadAsync(representation)">
                        @representation
                    </MudButton>
                }
            </DashboardCard>
        }
    }
</MudContainer>

@code
{
    [Parameter] public string RunId { get; set; } = string.Empty;

    private bool IsLoading = true;
    private string? UnavailableReason;
    private WebRunStatus? Status;
    private WebResultView? View;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        IsLoading = false;
    }

    private async Task RefreshAsync()
    {
        WebRunId id;
        try
        {
            id = WebRunId.Parse(RunId);
        }
        catch (Exception)
        {
            UnavailableReason = "The run id is not valid.";
            return;
        }

        var status = await ValidationService.GetStatusAsync(id);
        if (status is WebRunStatusResult.Unavailable unavailable)
        {
            UnavailableReason = unavailable.Reason;
            Status = null;
            View = null;
            return;
        }

        Status = ((WebRunStatusResult.Known)status).Status;

        if (Status is WebRunStatus.CompletedClean or WebRunStatus.CompletedWithFindings or WebRunStatus.Failed)
        {
            var result = await ValidationService.GetResultAsync(id);
            if (result is WebResultRetrieval.Ready ready)
            {
                View = ready.View;
            }
            else if (result is WebResultRetrieval.Unavailable gone)
            {
                UnavailableReason = gone.Reason;
            }
        }
    }

    private async Task DownloadAsync(ReportRepresentation representation)
    {
        var id = WebRunId.Parse(RunId);
        using var stream = new MemoryStream();
        var export = await ValidationService.ExportAsync(id, representation, stream);
        if (export is WebExportResult.Written)
        {
            // The boundary hands the caller typed data; the host is
            // responsible for presentation and delivery.
            stream.Position = 0;
            using var reader = new StreamReader(stream);
            var text = await reader.ReadToEndAsync();
            await JS.InvokeVoidAsync("certus.downloadReport",
                RunId, representation.ToString(), text);
        }
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;
}
