<MudPaper Class="pa-4" Style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border: 1px solid #334155; border-radius: 16px; position: relative; overflow: hidden;">
    <div style="position: absolute; top: 0; right: 0; width: 80px; height: 80px; background: radial-gradient(circle, @IconColor 0%, transparent 70%); opacity: 0.08; border-radius: 50%; transform: translate(20px, -20px);"></div>
    @if (IsLoading)
    {
        <MudSkeleton Animation="Animation.Wave" Width="80px" Height="14px" Class="mb-2" />
        <MudSkeleton Animation="Animation.Wave" Width="120px" Height="28px" />
    }
    else
    {
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
            <div style="width: 36px; height: 36px; border-radius: 10px; background: @IconBgColor; display: flex; align-items: center; justify-content: center;">
                <MudIcon Icon="@Icon" Size="Size.Small" Style="@($"color: {IconColor};")" />
            </div>
            <MudText Typo="Typo.caption" Style="color: #94a3b8; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; font-size: 0.7rem;">@Label</MudText>
        </div>
        <div style="display: flex; align-items: baseline; gap: 10px;">
            <MudText Typo="Typo.h5" Style="color: white; font-weight: 800; font-family: 'Inter', monospace; letter-spacing: -0.02em;">@Value</MudText>
            @if (Trend != 0)
            {
                var trendColor = Trend > 0 ? "#00ff88" : "#ff4466";
                var trendPrefix = Trend > 0 ? "+" : "";
                var trendBg = Trend > 0 ? "rgba(0, 255, 136, 0.1)" : "rgba(255, 68, 102, 0.1)";
                <div style="background: @trendBg; padding: 2px 8px; border-radius: 6px;">
                    <MudText Typo="Typo.caption" Style="@($"color: {trendColor}; font-weight: 700; font-size: 0.75rem;")">
                        @trendPrefix@Trend.ToString("P1")
                    </MudText>
                </div>
            }
        </div>
    }
</MudPaper>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.AttachMoney;
    [Parameter] public decimal Trend { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string IconColor { get; set; } = "#3b82f6";
    [Parameter] public string IconBgColor { get; set; } = "rgba(59, 130, 246, 0.15)";
}
