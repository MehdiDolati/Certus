<MudDialog @bind-Visible="Visible" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: white;">@(IsEdit ? "Edit Portfolio" : "Create Portfolio")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="Model.Name" Label="Name" Variant="Variant.Outlined" Required="true"
                              Error="@(!string.IsNullOrEmpty(_nameError))" ErrorText="@_nameError" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="Model.Description" Label="Description" Variant="Variant.Outlined"
                              Lines="3" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField @bind-Value="Model.TargetReturn" Label="Target Return (%)" Variant="Variant.Outlined"
                                 Adornment="Adornment.End" AdornmentText="%" Min="0m" Max="100m" Step="0.5m" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField @bind-Value="Model.TargetSharpe" Label="Target Sharpe" Variant="Variant.Outlined"
                                 Min="0m" Max="10m" Step="0.1m" />
            </MudItem>
            <MudItem xs="12">
                <MudNumericField @bind-Value="Model.AllocatedCapital" Label="Allocated Capital (USD)" Variant="Variant.Outlined"
                                 Adornment="Adornment.Start" AdornmentText="$" Min="0m" Step="100000m" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@_submitting">
            @if (_submitting) { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> }
            else { @(IsEdit ? "Save" : "Create") }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public PortfolioFormModel Model { get; set; } = new();
    [Parameter] public EventCallback<PortfolioFormModel> OnSubmit { get; set; }

    private bool _submitting;
    private string? _nameError;

    private async Task Submit()
    {
        _nameError = string.IsNullOrWhiteSpace(Model.Name) ? "Name is required" : null;
        if (_nameError is not null) return;

        _submitting = true;
        StateHasChanged();

        await OnSubmit.InvokeAsync(Model);

        _submitting = false;
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    private async Task Cancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    public class PortfolioFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal TargetReturn { get; set; }
        public decimal TargetSharpe { get; set; }
        public decimal AllocatedCapital { get; set; }
    }
}
